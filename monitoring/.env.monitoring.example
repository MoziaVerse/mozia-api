# ==============================================================================
# Mozia Monitoring Stack Environment Template (Plan A: Agent + Monitoring Host)
# Copy to .env.monitoring on your server and fill in real values.
# NEVER commit .env.monitoring with real secrets or webhooks to Git.
# ==============================================================================

# Environment tag shown in Feishu alert titles (e.g. prod, test-21)
ALERT_ENV=prod

# ------------------------------------------------------------------------------
# Part 1: Business Host Exporter Agent (docker-compose.agent.yml)
# Bind strictly to the private/internal LAN IP (NEVER 0.0.0.0 on public NIC).
# ------------------------------------------------------------------------------
AGENT_BIND_IP=172.16.10.110
NODE_EXPORTER_PORT=9100
CADVISOR_IMAGE=gcr.m.daocloud.io/cadvisor/cadvisor:v0.55.1
CADVISOR_PORT=8088
POSTGRES_EXPORTER_PORT=9187
REDIS_EXPORTER_PORT=9121

# Read-only PostgreSQL monitoring account created by monitoring/postgres/init-monitor-user.sql
# Example: postgresql://mozia_monitor:replace_with_pg_monitor_password@postgres-dev:5432/mozia_api_db?sslmode=disable
PG_EXPORTER_DSN=postgresql://mozia_monitor:replace_with_pg_monitor_password@postgres-dev:5432/mozia_api_db?sslmode=disable

# Redis target inside the shared Docker network
REDIS_EXPORTER_ADDR=redis://redis-newapi:6379
REDIS_EXPORTER_PASSWORD=

# Docker external network names on the business host
POSTGRES_DOCKER_NETWORK=postgres_db_internal
MOZIA_API_DOCKER_NETWORK=mozia-api_mozia-api-network

# ------------------------------------------------------------------------------
# Part 2: Standalone Monitoring Server (docker-compose.monitoring.yml)
# ------------------------------------------------------------------------------
# Bind Monitoring UIs to localhost (access via Caddy HTTPS / SSH tunnel / VPN)
MONITORING_BIND_IP=127.0.0.1
PROMETHEUS_PORT=9090
ALERTMANAGER_PORT=9093
GRAFANA_PORT=3030
UPTIME_KUMA_PORT=3001

# Business host internal IP (used by scripts/render-targets.sh to generate Prometheus targets)
BUSINESS_HOST_IP=172.16.10.110
MOZIA_PRIMARY_METRICS_PORT=9091
MOZIA_REPLICA_METRICS_PORT=9092

# Optional Bearer token matching METRICS_TOKEN in mozia-api's .env
METRICS_TOKEN=

# Prometheus TSDB retention (30 days for monthly enterprise SLA review)
PROMETHEUS_RETENTION_TIME=30d
PROMETHEUS_RETENTION_SIZE=25GB

# Grafana admin credentials (replace before starting!)
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=replace_with_grafana_admin_password
GRAFANA_EXTERNAL_URL=http://127.0.0.1:3030
UPTIME_KUMA_EXTERNAL_URL=
ALERTMANAGER_EXTERNAL_URL=

# ------------------------------------------------------------------------------
# Part 3: Feishu Alert Webhook (with signature verification)
# ------------------------------------------------------------------------------
FEISHU_WEBHOOK_URL=https://open.feishu.cn/open-apis/bot/v2/hook/replace_with_webhook_id
FEISHU_SECRET=replace_with_feishu_signing_secret

# Optional: route Critical alerts to a separate urgent group webhook (defaults to FEISHU_WEBHOOK_URL)
FEISHU_CRITICAL_WEBHOOK_URL=
FEISHU_CRITICAL_SECRET=
FEISHU_AT_ALL_ON_CRITICAL=true
